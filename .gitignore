# ──────────────────────────────────────────────
# Victoria 3 Game Tracker - .gitignore
# ──────────────────────────────────────────────

# ── Database files (live data, not tracked) ──
*.db
*.db-shm
*.db-wal

# ── Database backups ──
victoria3_tracker/database/backup/

# ── Logs ──
logs/
*.log

# ── Configuration ──
config.json
user_law_mods.json

# ── Python cache ──
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ──
venv/
.venv/
env/
.env/

# ── Testing / coverage ──
.pytest_cache/
.hypothesis/
htmlcov/
.coverage
coverage.xml

# ── Build / dist ──
build/
dist/
*.egg-info/
*.egg

# ── OS junk ──
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ──
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── rakaly binary (users download their own) ──
rakaly.exe

# ── Test data ──
test/