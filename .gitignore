# ──────────────────────────────────────────────
# Victoria 3 Game Tracker — .gitignore
# ──────────────────────────────────────────────

# ── Database files (live data, not tracked) ──
victoria3_tracker/database/*.db
victoria3_tracker/database/*.db-shm
victoria3_tracker/database/*.db-wal

# ── Database backups ──
victoria3_tracker/database/backup/

# ── Logs ──
logs/
*.log

# ── Configuration (may contain personal paths) ──
# Uncomment the line below if you don't want to track config.json
# config.json

# ── Python cache ──
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ──
venv/
.venv/
env/
.env/

# ── Testing / coverage ──
.pytest_cache/
.hypothesis/
htmlcov/
.coverage
coverage.xml

# ── Build / dist ──
build/
dist/
*.egg-info/
*.egg

# ── OS junk ──
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ──
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.kiro/

# ── rakaly binary (users download their own) ──
rakaly.exe
